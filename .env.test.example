# Copy to .env.test.local and replace each placeholder with credentials for a
# disposable local MySQL account that can create, drop, migrate and truncate
# only the mypetmart_test database. Do not use production credentials.
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_NAME=mypetmart_test
TEST_DB_USER=replace_with_dedicated_test_user
TEST_DB_PASSWORD=replace_with_dedicated_test_password
