
NODE_ENV=development
SHIPMENT_NUMBER_PREFIX=TEST-SHP
PORT=5000
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb

STOREFRONT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:4000

# Local Development Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mypetmart
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
PRODUCT_SAFE_TRASH_CUTOFF=2026-08-11T14:00:00.000Z

# Production Database (Used automatically when NODE_ENV=production)
PRODUCTION_DB_HOST=118.139.180.2
PRODUCTION_DB_PORT=3306
PRODUCTION_DB_NAME=mypetmart
PRODUCTION_DB_USER=
PRODUCTION_DB_PASSWORD=


# Stage 11 placeholders. Keep unset until authentication is implemented.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_SALT_ROUNDS=12

# Cloudflare R2. Leave all credential fields empty when R2 is intentionally not configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_INTENT_SECRET=
R2_UPLOAD_URL_EXPIRY_SECONDS=300
R2_MAX_IMAGE_SIZE_BYTES=5242880
R2_ORPHAN_GRACE_HOURS=24

# PayU Hosted Checkout. PAYMENT_KEY_ID is PayU's merchant "key" (submitted in
# the browser form, not secret on its own). PAYMENT_KEY_SECRET is PayU's
# merchant "salt" — server-only, must never reach the browser, logs, or raw_payload.
# PAYMENT_GATEWAY_URL is optional; unset falls back to PayU's published
# test/live Hosted Checkout URL based on NODE_ENV.
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_GATEWAY_URL=

# iThink Logistics V3. Leave credentials/warehouse values blank until the
# account is provisioned; the backend reports shipping as unconfigured.
SHIPPING_API_KEY=
SHIPPING_WEBHOOK_SECRET=

SHIPPING_PROVIDER=ithink
ITHINK_ACCESS_TOKEN=
ITHINK_SECRET_KEY=
ITHINK_API_BASE_URL=https://my.ithinklogistics.com
ITHINK_TRACKING_BASE_URL=https://my.ithinklogistics.com
ITHINK_STORE_ID=
ITHINK_PICKUP_ADDRESS_ID=
ITHINK_RETURN_ADDRESS_ID=
ITHINK_ORIGIN_PINCODE=
ITHINK_TIMEOUT_MS=30000
