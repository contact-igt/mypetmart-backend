{
  "name": "mypetmart-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --pool=threads --exclude tests/database/migrations/** --exclude tests/database/seeders/**",
    "test:watch": "vitest --pool=threads",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','coverage']) fs.rmSync(path,{recursive:true,force:true});\"",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:check": "tsx src/scripts/db-check.ts",
    "db:truncate:all": "tsx src/scripts/truncate-all-data.ts",
    "db:truncate:table": "tsx src/scripts/truncate-table.ts",
    "db:drop:all": "tsx src/scripts/drop-all-tables.ts",
    "db:add-super-admin": "tsx src/scripts/add-super-admin.ts",
    "db:migrate": "tsx src/database/commands/migrate.ts",
    "db:migrate:status": "tsx src/database/commands/migrate-status.ts",
    "db:migrate:down": "tsx src/database/commands/migrate-down.ts",
    "db:migrate:down:all": "tsx src/database/commands/migrate-down-all.ts",
    "db:schema:verify": "tsx src/database/commands/verify-schema.ts",
    "test:migrations": "vitest run tests/database/migrations/migration.integration.test.ts --pool=threads --sequence.concurrent=false",
    "db:seed": "tsx src/database/commands/seed.ts",
    "db:seed:status": "tsx src/database/commands/seed-status.ts",
    "db:seed:down": "tsx src/database/commands/seed-down.ts",
    "db:seed:down:all": "tsx src/database/commands/seed-down-all.ts",
    "test:seeders": "vitest run tests/database/seeders/seeder-integration.test.ts --pool=threads --sequence.concurrent=false",
    "email:check": "tsx src/scripts/email-check.ts",
    "email:test": "tsx src/scripts/email-test.ts",
    "r2:cleanup:orphans": "tsx src/scripts/r2-cleanup-orphans.ts",
    "r2:smoke": "tsx src/scripts/r2-smoke-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
